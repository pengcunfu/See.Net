<UserControl x:Class="See.Views.PdfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="360">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="ErrorBar" Grid.Row="0" Background="#FEF2F2" BorderBrush="#FECACA"
                BorderThickness="0,0,0,1" Padding="10,6" Visibility="Collapsed">
            <TextBlock Text="{Binding Error}" Foreground="#B91C1C" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <ContentControl x:Name="WebSlot" Grid.Row="1"/>
    </Grid>
</UserControl>
