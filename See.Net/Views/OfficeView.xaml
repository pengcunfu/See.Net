<UserControl x:Class="See.Views.OfficeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:See.Views"
             xmlns:core="clr-namespace:See.Net.Core.Office;assembly=See.Net.Core"
             xmlns:conv="clr-namespace:See.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:ByteArrayToImageConverter x:Key="BytesToImage" DecodePixelWidth="720"/>
        <conv:EmptyCollectionToVisibilityConverter x:Key="EmptyCollToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:PathToBitmapConverter x:Key="PathToImage" DecodePixelWidth="1600"/>
        <!-- EngineToggle 样式已上移 App.xaml（多视图共用） -->

        <!-- Word 块模板（WordListView 用） -->
        <DataTemplate x:Key="WordBlockTemplate">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Padding="12,2" FontSize="13"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Heading1">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" FontSize="20" FontWeight="Bold"
                                                       Padding="12,10,12,4" Foreground="#111827" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Heading2">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" FontSize="17" FontWeight="SemiBold"
                                                       Padding="12,8,12,3" Foreground="#1F2937" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Heading3">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" FontSize="15" FontWeight="SemiBold"
                                                       Padding="12,6,12,2" Foreground="#374151" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Bullet">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock TextWrapping="Wrap" Padding="24,2,12,2" Foreground="#1F2937">
                                                <Run Text="•  "/><Run Text="{Binding Text}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="TableRow">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding Cells}" Margin="12,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#E5E7EB" BorderThickness="1" MinWidth="90" Padding="6,3">
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 引擎切换工具条 -->
        <Border Grid.Row="0" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="10,5">
            <StackPanel Orientation="Horizontal">
                <Border Background="#E5E7EB" CornerRadius="5" Padding="2" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="结构化" GroupName="engine" Style="{StaticResource EngineToggle}"
                                     Padding="12,4" Command="{Binding UseStructuredCommand}"/>
                        <RadioButton Content="网页预览" GroupName="engine" Style="{StaticResource EngineToggle}"
                                     Padding="12,4" Command="{Binding UseWebViewCommand}"
                                     IsEnabled="{Binding CanUseWeb}"
                                     ToolTip="{Binding WebBlockReason}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding WebError}" Foreground="#B91C1C" FontSize="11"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"
                           ToolTip="{Binding WebError}"/>
                <TextBlock Text="{Binding WebBlockReason}" Foreground="#6B7280" FontSize="11"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTip="{Binding WebBlockReason}"/>
            </StackPanel>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <!-- Word 结构化 -->
            <ScrollViewer x:Name="WordRegion" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Structured.Blocks}" ItemTemplate="{StaticResource WordBlockTemplate}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Excel 结构化 -->
            <Grid x:Name="SheetRegion">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="10,6">
                    <TextBlock Text="工作表：" VerticalAlignment="Center"/>
                    <ComboBox x:Name="SheetPicker" MinWidth="140" Margin="4,0"
                              SelectionChanged="SheetPicker_SelectionChanged"/>
                    <TextBlock x:Name="SheetStats" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <DataGrid x:Name="SheetGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
                          HeadersVisibility="Column" GridLinesVisibility="All" CanUserAddRows="False"
                          SelectionMode="Extended" SelectionUnit="Cell"
                          FontSize="12" RowHeight="24" EnableRowVirtualization="True" EnableColumnVirtualization="True"/>
            </Grid>

            <!-- PPT：优先整页画面（PowerPoint 导出 PNG），否则文字/内嵌图 -->
            <ListBox x:Name="SlidesRegion" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     ItemsSource="{Binding Structured.Slides}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="#EEF2FF" CornerRadius="3" Padding="6,1" Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Index, StringFormat=第 {0} 页}" FontSize="11" Foreground="#4338CA"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- PowerPoint 导出的整页画面（优先） -->
                                <Border Margin="0,0,0,8" BorderBrush="#E5E7EB" BorderThickness="1" Background="#111827"
                                        Visibility="{Binding RenderedImagePath, Converter={StaticResource NullToVis}}">
                                    <Image Source="{Binding RenderedImagePath, Converter={StaticResource PathToImage}}"
                                           Stretch="Uniform" MaxHeight="560"/>
                                </Border>
                                <!-- 无整页导出时：内嵌图缩略图 + 文字 -->
                                <ItemsControl ItemsSource="{Binding Images}" Margin="0,0,0,8">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RenderedImagePath}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,8,8" BorderBrush="#E5E7EB" BorderThickness="1"
                                                    Background="#FAFAFA" MaxWidth="360" MaxHeight="240">
                                                <Image Source="{Binding Bytes, Converter={StaticResource BytesToImage}}"
                                                       Stretch="Uniform" MaxHeight="220" Margin="4"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Lines}" Margin="4,0,0,0"
                                              Visibility="{Binding RenderedImagePath, Converter={StaticResource NullToVis}, ConverterParameter=Invert}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#374151" Padding="0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 网页渲染视图（代码后置按需注入 OfficeWebHost） -->
            <ContentControl x:Name="WebHostSlot"/>

            <!-- 加载 / 提示（代码后置按 State 控制） -->
            <TextBlock x:Name="LoadingText" Text="{Binding LoadingMessage}" Foreground="#6B7280" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                       TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
            <Border x:Name="SoftNoticeBanner" Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="0,0,0,1"
                    Padding="12,8" VerticalAlignment="Top" Visibility="Collapsed">
                <TextBlock x:Name="SoftNoticeText" Foreground="#92400E" FontSize="12" TextWrapping="Wrap"/>
            </Border>
            <StackPanel x:Name="NoticePanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="560" TextBlock.TextAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="NoticeTitle" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock x:Name="NoticeBody" Foreground="#6B7280" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
