<UserControl x:Class="See.Views.OfficeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:See.Views"
             xmlns:core="clr-namespace:See.Net.Core.Office;assembly=See.Net.Core">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- EngineToggle 样式已上移 App.xaml（多视图共用） -->

        <!-- Word 块模板（WordListView 用） -->
        <DataTemplate x:Key="WordBlockTemplate">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Padding="12,2" FontSize="13"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Heading1">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" FontSize="20" FontWeight="Bold"
                                                       Padding="12,10,12,4" Foreground="#111827" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Heading2">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" FontSize="17" FontWeight="SemiBold"
                                                       Padding="12,8,12,3" Foreground="#1F2937" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Heading3">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" FontSize="15" FontWeight="SemiBold"
                                                       Padding="12,6,12,2" Foreground="#374151" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Bullet">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock TextWrapping="Wrap" Padding="24,2,12,2" Foreground="#1F2937">
                                                <Run Text="•  "/><Run Text="{Binding Text}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="TableRow">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding Cells}" Margin="12,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#E5E7EB" BorderThickness="1" MinWidth="90" Padding="6,3">
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 引擎切换工具条 -->
        <Border Grid.Row="0" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="10,5">
            <StackPanel Orientation="Horizontal">
                <Border Background="#E5E7EB" CornerRadius="5" Padding="2" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="结构化" GroupName="engine" Style="{StaticResource EngineToggle}"
                                     Padding="12,4" Command="{Binding UseStructuredCommand}"/>
                        <RadioButton Content="网页预览" GroupName="engine" Style="{StaticResource EngineToggle}"
                                     Padding="12,4" Command="{Binding UseWebViewCommand}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding WebError}" Foreground="#B91C1C" FontSize="11"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
            </StackPanel>
        </Border>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <!-- Word 结构化 -->
            <ScrollViewer x:Name="WordRegion" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Structured.Blocks}" ItemTemplate="{StaticResource WordBlockTemplate}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Excel 结构化 -->
            <Grid x:Name="SheetRegion">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="10,6">
                    <TextBlock Text="工作表：" VerticalAlignment="Center"/>
                    <ComboBox x:Name="SheetPicker" MinWidth="140" Margin="4,0"
                              SelectionChanged="SheetPicker_SelectionChanged"/>
                    <TextBlock x:Name="SheetStats" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <DataGrid x:Name="SheetGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False"
                          HeadersVisibility="Column" GridLinesVisibility="All" CanUserAddRows="False"
                          SelectionMode="Extended" SelectionUnit="Cell"
                          FontSize="12" RowHeight="24" EnableRowVirtualization="True" EnableColumnVirtualization="True"/>
            </Grid>

            <!-- PPT 结构化 -->
            <ScrollViewer x:Name="SlidesRegion" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Structured.Slides}" Margin="12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="8,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#EEF2FF" CornerRadius="3" Padding="6,1" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Index, StringFormat=第 {0} 页}" FontSize="11" Foreground="#4338CA"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Lines}" Margin="28,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#374151" Padding="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 网页渲染视图（代码后置按需注入 OfficeWebHost） -->
            <ContentControl x:Name="WebHostSlot"/>

            <!-- 加载 / 提示（代码后置按 State 控制） -->
            <TextBlock x:Name="LoadingText" Text="正在解析文档…" Foreground="#6B7280" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            <StackPanel x:Name="NoticePanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="560" TextBlock.TextAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="NoticeTitle" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock x:Name="NoticeBody" Foreground="#6B7280" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
