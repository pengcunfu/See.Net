<UserControl x:Class="See.Net.Views.ImageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White">
            <Grid>
                <Image x:Name="Pic" Source="{Binding Image}" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1" 
                                        CenterX="0" CenterY="0"/>
                    </Image.RenderTransform>
                </Image>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#F7F7F7" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <Button Content="适应窗口" Padding="10,3" Margin="0,0,6,0" Click="OnFit"/>
                <Button Content="实际大小" Padding="10,3" Margin="0,0,6,0" Click="OnActualSize"/>
                <Button Content="放大" Padding="10,3" Margin="0,0,6,0" Click="OnZoomIn"/>
                <Button Content="缩小" Padding="10,3" Margin="0,0,6,0" Click="OnZoomOut"/>
                <TextBlock Text="{Binding Info}" VerticalAlignment="Center" Foreground="Gray" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
