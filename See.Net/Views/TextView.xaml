<UserControl x:Class="See.Net.Views.TextView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F7F7F7" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <StackPanel x:Name="EditControls" Orientation="Horizontal">
                    <ToggleButton Content="编辑模式" IsChecked="{Binding IsEditMode}" Padding="10,3" Margin="0,0,8,0"/>
                    <Button Content="保存" Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}"
                            Padding="12,3" Margin="0,0,8,0" FontWeight="SemiBold"/>
                </StackPanel>
                <ComboBox ItemsSource="{Binding Encodings}" SelectedItem="{Binding SelectedEncoding}"
                          Width="150" Margin="0,0,8,0" ToolTip="编码"/>
                <ToggleButton Content="自动换行" IsChecked="{Binding WordWrap}" Padding="10,3"/>
            </StackPanel>
        </Border>

        <avalonedit:TextEditor x:Name="Editor" Grid.Row="1" FontFamily="Consolas" FontSize="13"
                               ShowLineNumbers="True" IsReadOnly="{Binding IsReadOnly}"/>
    </Grid>
</UserControl>
