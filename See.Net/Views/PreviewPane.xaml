<UserControl x:Class="See.Net.Views.PreviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:See.Net.Views"
             xmlns:vm="clr-namespace:See.Net.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="680"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis" MaxWidth="680"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Esc 关闭 · ↑/↓ 切换文件" FontSize="11" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Content="✕" FontSize="13" Padding="9,3" ToolTip="关闭预览"
                            Command="{Binding DataContext.ClosePreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding Content}" Focusable="False">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vm:TextContentViewModel}">
                    <views:TextView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:HexContentViewModel}">
                    <views:HexEditorView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:ImageContentViewModel}">
                    <views:ImageView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:InfoContentViewModel}">
                    <views:InfoView/>
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </Grid>
</UserControl>
