<Window x:Class="See.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24,20">
        <TextBlock x:Name="ProductNameText" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock x:Name="VersionText" Foreground="#666666" Margin="0,0,0,12"/>
        <TextBlock Text="空格快速预览与十六进制编辑器"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBlock Margin="0,0,0,6" TextWrapping="Wrap">
            <Run Text="开源地址："/>
            <Hyperlink NavigateUri="https://github.com/pengcunfu/See.Net"
                       RequestNavigate="OnLinkClick">
                https://github.com/pengcunfu/See.Net
            </Hyperlink>
        </TextBlock>
        <TextBlock Margin="0,0,0,12" TextWrapping="Wrap">
            <Run Text="程序文档："/>
            <Hyperlink NavigateUri="https://my.feishu.cn/wiki/V7w4wJt4AitmQ0kXN5PcrNENnUg?from=from_copylink"
                       RequestNavigate="OnLinkClick">
                飞书 Wiki
            </Hyperlink>
        </TextBlock>

        <TextBlock Text="飞书交流群" Margin="0,0,0,8"/>
        <Image Source="Assets/feishu.png" Width="160" Height="160"
               Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,8"
               SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="扫码加入飞书群" Foreground="#888888" FontSize="12" Margin="0,0,0,16"/>

        <TextBlock x:Name="CopyrightText" Foreground="#888888" FontSize="12" Margin="0,0,0,18"/>
        <Button Content="确定" IsDefault="True" IsCancel="True" Click="OnOkClick"
                HorizontalAlignment="Right" Padding="22,5"/>
    </StackPanel>
</Window>
