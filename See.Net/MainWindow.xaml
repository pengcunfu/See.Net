<Window x:Class="See.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:See.Views"
        Title="See.Net"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewKeyDown="OnPreviewKeyDown"
        DragOver="OnDragOver"
        Drop="OnDrop"
        Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="4,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource ToolbarButton}" Content="&#xE72B;" ToolTip="后退"
                        Command="{Binding NavigateBackCommand}" IsEnabled="{Binding CanGoBack}"/>
                <Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Content="&#xE72A;" ToolTip="前进"
                        Command="{Binding NavigateForwardCommand}" IsEnabled="{Binding CanGoForward}"/>
                <Button Grid.Column="2" Style="{StaticResource ToolbarButton}" Content="&#xE74A;" ToolTip="上级目录"
                        Command="{Binding NavigateUpCommand}"/>
                <Button Grid.Column="3" Style="{StaticResource ToolbarButton}" Content="&#xE72C;" ToolTip="刷新"
                        Command="{Binding RefreshCommand}"/>
                <TextBox x:Name="PathBox" Grid.Column="4" Margin="8,0" Padding="6,4"
                         Text="{Binding CurrentDirectory, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" KeyDown="OnPathKeyDown"/>
                <Button Grid.Column="5" Content="转到" Padding="12,4" Click="OnGoClick" ToolTip="进入输入的目录"/>
            </Grid>
        </Border>

        <ListView x:Name="FileList" Grid.Row="1" Background="White" BorderThickness="0"
                  ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                  MouseDoubleClick="OnFileDoubleClick" VirtualizingPanel.IsVirtualizing="True">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="名称" Width="460">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding FullPath}">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                               Foreground="#78909C" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="大小" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SizeText}" TextAlignment="Right"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="修改时间" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LastWriteTime, StringFormat=yyyy-MM-dd HH:mm}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="类型" Width="90" DisplayMemberBinding="{Binding KindText}"/>
                </GridView>
            </ListView.View>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="空格预览" Command="{Binding OpenPreviewCommand}"/>
                    <MenuItem Header="复制路径" Command="{Binding CopyPathCommand}"/>
                    <Separator/>
                    <MenuItem Header="刷新" Command="{Binding RefreshCommand}"/>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid x:Name="PreviewOverlay" Grid.RowSpan="3" Background="#66000000" Visibility="Collapsed"
              MouseLeftButtonDown="OnOverlayClick">
            <!-- Stretch：给 WebView2 等内容明确视口；Center+自适应会把零 DesiredSize 的宿主压成仅剩标题栏 -->
            <Border x:Name="PreviewPaneHost" Margin="90" Background="White"
                    CornerRadius="8" BorderBrush="#404040" BorderThickness="1" Focusable="True"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.5"/>
                </Border.Effect>
                <views:PreviewPane DataContext="{Binding Preview}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
