<Window x:Class="See.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="更新" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="18,14">
        <TextBlock x:Name="VersionLine" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <TextBlock x:Name="StateText" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <ProgressBar x:Name="ProgressBar" Height="16" Margin="0,0,0,8"
                     Minimum="0" Maximum="100" Visibility="Collapsed"/>

        <TextBlock Text="更新内容：" Foreground="#666666" FontSize="12" Margin="0,0,0,4"
                   x:Name="NotesHeader" Visibility="Collapsed"/>
        <ScrollViewer x:Name="NotesScroller" MaxHeight="200" Margin="0,0,0,10"
                      VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <TextBlock x:Name="NotesText" TextWrapping="Wrap" Foreground="#444444" FontSize="12"/>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="PrimaryButton" Padding="18,5" Margin="0,0,8,0" Click="OnPrimaryClick" Visibility="Collapsed"/>
            <Button x:Name="SecondaryButton" Content="关闭" IsCancel="True" Padding="18,5" Click="OnCloseClick"/>
        </StackPanel>
    </StackPanel>
</Window>
